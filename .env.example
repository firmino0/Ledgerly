# SERV Reasoning (OpenAI-compatible endpoint at https://inference-api.openserv.ai/v1)
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Robinhood Chain: testnet (46630) by default. Set to "mainnet" (4663) only with tiny amounts.
NETWORK=testnet
# Agent wallet key. Use a fresh throwaway wallet. Never reuse a real one.
AGENT_PRIVATE_KEY=
# Payment token (USDG) address on the selected network
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_DECIMALS=6

# Safety: dry-run is ON unless explicitly set to "false"
DRY_RUN=true
# Going live on mainnet (real money) also needs this set to "yes". Start with a tiny amount.
LIVE_MAINNET=no
# Max price slippage on swaps, in basis points (50 = 0.5%)
SLIPPAGE_BPS=50

# Guardrails (in USD units of the payment token)
MAX_PER_TX=50
MAX_PER_DAY=200
APPROVAL_THRESHOLD=25

# Optional: bearer token for Robinhood Agentic Trading MCP (read-only). Robinhood login is OAuth in a desktop browser.
# ROBINHOOD_MCP_TOKEN=

# ---- Hosted mode only (Vercel). Not needed locally. See DEPLOY.md. ----
# DASHBOARD_PASSWORD=          # login for the hosted dashboard, 12+ characters (use 20+)
# AUTH_SECRET=                 # signs the login cookie
# CRON_SECRET=                 # protects /api/cron
# SESSION_HOURS=12
# Redis connection is added by the Vercel Marketplace integration (KV_REST_API_URL / KV_REST_API_TOKEN).
# SANDBOX_ENABLED=yes          # /sandbox: private simulated copy per visitor (needs Redis + AUTH_SECRET)
# USERS_ENABLED=yes            # /account: real accounts, each person signs with their own wallet
# USER_MAX_PER_TX=25
# USER_MAX_PER_DAY=100
# USERS_ALLOW_SELLS=yes        # only after a live sale has been tested
